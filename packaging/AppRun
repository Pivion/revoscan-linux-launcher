#!/usr/bin/env bash
set -euo pipefail
APPDIR="${APPDIR:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")}"
export APPDIR
export PYTHONUNBUFFERED=1
export REVOSCAN_HOST_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="$APPDIR/usr/share/vulkan/explicit_layer.d:$APPDIR/opt/wine-staging/lib/wine/x86_64-unix:$APPDIR/opt/wine-staging/lib:$APPDIR/usr/lib/wine/x86_64-unix:$APPDIR/usr/lib64/wine-wow64/wine/x86_64-unix${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$APPDIR/usr/bin/revoscan-launcher" "$@"
